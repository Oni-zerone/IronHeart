# Copia in .env (escluso da git). In produzione: variabili d'ambiente dell'app su CapRover.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Indirizzo da cui il browser raggiunge il servizio. Con Vite: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
# BIND_ADDR=127.0.0.1:8080
# DATABASE_URL=sqlite://data/ironheart.db

# Email: smtp (Mailpit in locale) oppure brevo (produzione)
MAIL_TRANSPORT=smtp
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=noreply@tuodominio.it
# MAIL_FROM_NAME=IronHeart
# SMTP_HOST=localhost
# SMTP_PORT=1025
