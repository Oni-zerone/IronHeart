# Copia in .env (escluso da git). In produzione: variabili d'ambiente dell'app su CapRover.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Indirizzo da cui il browser raggiunge il servizio. Con Vite: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
# BIND_ADDR=127.0.0.1:8080
# Database: senza DATABASE_URL si usa il file SQLite locale (sqlite://data/ironheart.db),
# che in un container sparisce a ogni deploy se non sta su un volume.
# Postgres esterno (consigliato in produzione; sslmode=require per i database gestiti):
# DATABASE_URL=postgres://utente:password@host:5432/ironheart?sslmode=require
# In locale: docker compose up -d postgres
# DATABASE_URL=postgres://ironheart:ironheart@localhost:5432/ironheart

# Email: smtp (Mailpit in locale) oppure brevo (produzione)
MAIL_TRANSPORT=smtp
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=noreply@tuodominio.it
# MAIL_FROM_NAME=IronHeart
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Chiave master AES-256 dei segreti delle app: openssl rand -base64 32
SECRETS_KEY=
# SECRETS_KEY_VERSION=1
# IP del client dietro un proxy: x-forwarded-for (CapRover) o cf-connecting-ip (Cloudflare)
# CLIENT_IP_HEADER=x-forwarded-for

# Utente master: sempre admin, non si può declassare né rimuovere
ADMIN_EMAIL=
