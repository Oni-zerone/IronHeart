# Copy to .env (ignored by git). In production: the app's environment variables on CapRover.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address the browser uses to reach the service. With Vite: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
# BIND_ADDR=127.0.0.1:8080
# Database: without DATABASE_URL the local SQLite file is used (sqlite://data/ironheart.db),
# which in a container disappears at every deploy unless it is on a volume.
# External Postgres (recommended in production; sslmode=require for managed databases):
# DATABASE_URL=postgres://user:password@host:5432/ironheart?sslmode=require
# Locally: docker compose up -d postgres
# DATABASE_URL=postgres://ironheart:ironheart@localhost:5432/ironheart

# Email: smtp (Mailpit locally) or brevo (production)
MAIL_TRANSPORT=smtp
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=noreply@yourdomain.com
# MAIL_FROM_NAME=IronHeart
# SMTP_HOST=localhost
# SMTP_PORT=1025

# AES-256 master key for app secrets: openssl rand -base64 32
SECRETS_KEY=
# SECRETS_KEY_VERSION=1
# Client IP behind a proxy: x-forwarded-for (CapRover) or cf-connecting-ip (Cloudflare)
# CLIENT_IP_HEADER=x-forwarded-for

# Master user: always admin, cannot be demoted or removed
ADMIN_EMAIL=
